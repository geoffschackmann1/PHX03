# =============================================================================
# QPi Scorecard Automation — .gitignore
# =============================================================================

# CREDENTIALS & SECRETS (never commit these)
.env
*.p8
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
*.egg-info/
dist/
build/

# Output files (regenerated by pipeline)
output/
*.xlsx
*.pdf

# Input data (contains PHI/PII)
input/
*.csv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
